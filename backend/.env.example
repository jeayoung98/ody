DB_HOST=localhost
DB_PORT=5432
DB_NAME=backend
DB_USERNAME=postgres
DB_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis

NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_PASSWORD=neo4j

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 발급
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# openssl rand -base64 48 등으로 생성한 32바이트(HS256 최소 요구치) 이상의 랜덤 문자열
JWT_SECRET=

FRONTEND_OAUTH_REDIRECT_URI=

# 프로필 이미지 업로드 (S15P21A405-426)
# PROFILE_IMAGE_DIR: 업로드 파일이 저장되는 디렉터리. 배포 호스트에서는 컨테이너에 같은 경로로 마운트한다.
# PROFILE_IMAGE_BASE_URL: 저장된 파일의 공개 주소 접두. DB image_url 에 이 값 + / + 파일명이 들어간다.
PROFILE_IMAGE_DIR=./profileImages
PROFILE_IMAGE_BASE_URL=http://localhost:8080/api/user/images
