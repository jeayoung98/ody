<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.backend.mapper.UserMapper">

	<!-- "user"는 Postgres 예약어라 반드시 큰따옴표로 감싼다 -->

	<select id="findByEmail" resultType="com.ssafy.backend.dto.UserDto">
		SELECT email, name, nickname, image_url
		FROM "user"
		WHERE email = #{email}
	</select>

	<insert id="insert">
		INSERT INTO "user" (email, name, image_url)
		VALUES (#{email}, #{name}, #{imageUrl})
	</insert>

	<update id="touchLogin">
		UPDATE "user"
		SET last_active_at = now(),
		    updated_at = now(),
		    image_url = COALESCE(#{imageUrl}, image_url)
		WHERE email = #{email}
	</update>

	<delete id="deleteByEmail">
		DELETE FROM "user" WHERE email = #{email}
	</delete>

</mapper>
