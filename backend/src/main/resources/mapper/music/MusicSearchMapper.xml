<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.backend.music.mapper.MusicSearchMapper">

	<!--
		실제 테이블: public.music(id, mbid, title, artist, release_year, bpm, duration, album,
		youtube_url, location vector(16), play_cnt, youtube_cnt) — 6,624,399행 적재 완료.
		적재 결과상 release_year·album·youtube_url 은 전 행 NULL 이다(스펙 18 AC4).
		album 은 그대로 내려보내고, youtube_url 은 읽지 않는다 — YoutubeSearchUrl 이 조회 시 검색 URL 을 만든다(D12).

		좌표는 location 을 real[] 로 캐스팅해 16축을 그대로 펼친다. 반올림·재계산 없음(FR-006).
		data 팀 실측 질의와 같은 형태다: data/ingest/map_layer_queries.sql (origin/data/dev).

		prefix 는 어댑터가 만든 앞일치 패턴이다(사용자 입력의 %, _, \ 는 어댑터에서 이스케이프).
		부분일치(%q%)는 쓰지 않는다 — 앞뒤 와일드카드가 색인을 못 타서 걷어냈다(S15P21A405-298).
	-->

	<sql id="locationColumns">
		(m.location::real[])[1]  AS pc1,  (m.location::real[])[2]  AS pc2,
		(m.location::real[])[3]  AS pc3,  (m.location::real[])[4]  AS pc4,
		(m.location::real[])[5]  AS pc5,  (m.location::real[])[6]  AS pc6,
		(m.location::real[])[7]  AS pc7,  (m.location::real[])[8]  AS pc8,
		(m.location::real[])[9]  AS pc9,  (m.location::real[])[10] AS pc10,
		(m.location::real[])[11] AS pc11, (m.location::real[])[12] AS pc12,
		(m.location::real[])[13] AS pc13, (m.location::real[])[14] AS pc14,
		(m.location::real[])[15] AS pc15, (m.location::real[])[16] AS pc16
	</sql>

	<!--
		관련성 순 정렬 (S15P21A405-234). 점수를 매겨 정렬하지 않고 **단계별 조회**를 붙인다.

		왜 점수 정렬이 아닌가 — 2026-09-12 운영 DB 실측.
		  ORDER BY CASE WHEN ... END  는 일치 17만건의 점수를 전부 매겨야 상위 10개를 알 수 있어
		  조기 종료가 불가능하다. 실행계획이 Parallel Seq Scan + Sort 로 비용 252,888 이고 26초다.
		  단계마다 ORDER BY id LIMIT 을 두면 각각 PK 목차를 따라가다 채워지면 멈춘다(love 기준 3.9ms).

		단계는 서로 겹치지 않게 자른다. 아래 단계는 위 단계의 조건을 제외한다.
		  0 제목 완전일치 / 1 아티스트 완전일치 / 2 제목 앞일치 / 3 아티스트 앞일치
		  완전일치를 필드보다 앞에 둔다 — 정확도가 제목·가수 구분보다 강한 신호다. 'radiohead' 를 치면
		  그 이름의 가수를 원하지, 제목이 'Radiohead ...' 로 시작하는 곡을 원하는 게 아니다.

		내부 단계는 id 만 고르고 바깥에서 music 을 PK 로 다시 읽는다. 좁은 행만 넘기면 되므로
		좁히기 단계가 가벼워지고, 좌표 16칸을 네 번 반복하지 않아도 된다.

		5단계(나머지 부분일치)와 existsMatch 방패는 없앴다 (S15P21A405-298). 앞뒤 와일드카드 %q% 는
		어떤 B-tree 도 타지 못해 검색어와 무관하게 660만 행을 훑었다 — 0건 검색어가 9.5초였던 정체다.
		남은 네 단계는 전부 = 또는 LIKE 'q%' 라 아래 두 색인으로 0건이어도 즉시 끝난다(BE4, 2026-09-14).
		  CREATE INDEX music_title_lower  ON music (lower(title) text_pattern_ops);
		  CREATE INDEX music_artist_lower ON music (coalesce(lower(artist), '') text_pattern_ops);

		⚠ 색인 표현식은 아래 WHERE 와 **글자 단위로** 같아야 한다. artist 쪽 coalesce 를 빼면
		  1·3단계가 조용히 색인을 놓치고 27초로 돌아간다. 조건을 고칠 때 색인도 같이 고친다.
	-->
	<!--
		artist 는 NULL 이 될 수 있다. coalesce 없이 NOT (널 LIKE ...) 을 쓰면 결과가 NULL 이라
		조건이 참이 아니게 되고, 제목만 맞는 무명 아티스트 곡이 결과에서 조용히 빠진다.
	-->
	<sql id="titlePrefixed">lower(m.title) LIKE #{prefix} ESCAPE '\'</sql>
	<sql id="artistLower">coalesce(lower(m.artist), '')</sql>
	<sql id="artistPrefixed">coalesce(lower(m.artist), '') LIKE #{prefix} ESCAPE '\'</sql>

	<!--
		videoid_api.py 가 후보를 못 찾으면 video_id 에 "none" 을 저장한다(S15P21A405-332) — 수동 확인 전까지는
		재생 불가능한 곡이라 검색 결과에서 뺀다. video_id 가 아직 적재되지 않은 곡(NULL)은 그대로 노출한다
		(FR-007, videoId 는 응답에서 null 로 내려간다). IS DISTINCT FROM 은 NULL 도 참으로 통과시키는
		null-safe 비교라 이 구분에 맞는다 — <> 였다면 NULL 이 조건에서 조용히 걸러진다.
	-->
	<sql id="videoIdNotNone">m.video_id IS DISTINCT FROM 'none'</sql>

	<!--
		findPage 에 timeout="2" 가 붙어 있다 (S15P21A405-297). 초 단위이고 JDBC
		Statement.setQueryTimeout 으로 내려가, 2초를 넘기면 질의를 취소하고 커넥션을 풀에 돌려준다.

		검색을 빠르게 만드는 장치가 아니다 — 느린 질의를 포기시켜 피해 범위를 가두는 장치다.
		application-db.yml 의 풀이 5개이고 다른 API 의 커넥션 획득 한도가 5초다. 검색 한 건이
		27초씩 커넥션을 잡으면(2026-09-13 배포 실측: ove 27.0s, 사랑 23s, 0건 9.5s) 풀이 차는 순간
		지도·곡상세·플레이리스트까지 전부 5초 뒤 실패한다. 검색이 느린 문제가 아니라
		검색이 다른 기능을 죽이는 문제였다.

		왜 2초인가 — 색인이 붙으면 모든 질의가 수십 ms 아니면 풀스캔(초 단위)으로 갈리고
		그 사이에 실측된 정상 질의가 없다. 그래서 살리는 집합을 바꾸지 않으면서 방어 여유만
		키우는 쪽을 골랐다. 2초면 검색 5건이 동시에 몰려도 다른 API 가 3초 여유를 갖는다.
		1초까지 줄이면 DB 부하 스파이크에서 정상 질의를 죽일 수 있어 거기까진 안 간다.

		타임아웃이 걸리면 500 INTERNAL_SERVER_ERROR 로 나간다. 전용 코드를 만들지 않은 것은
		MusicErrorCode 가 이미 "엔진 부재·타임아웃은 INTERNAL_SERVER_ERROR 다" 로 정해 뒀기 때문이다.

		⚠ 색인이 붙어도 지우지 않는다. 색인은 성능을 코드로 강제하지 못한다 — 위 표현식과
		  색인 표현식이 한 글자라도 어긋나거나(coalesce·lower 누락), CONCURRENTLY 빌드가 실패해
		  INVALID 색인이 남거나, 재구축에서 색인이 빠지면 **에러 없이** 풀스캔으로 돌아간다.
		  테스트도 안 깨진다. 그 조용한 회귀를 "검색만 실패" 로 가두는 것이 이 값의 역할이다.
	-->

	<select id="findPage" timeout="2" resultType="com.ssafy.backend.music.dto.MusicSearchRow">
		SELECT m.id, m.title, m.artist, m.album, m.video_id,
		<include refid="locationColumns"/>
		FROM (
			(SELECT m.id, 0 AS tier FROM music m
			 WHERE lower(m.title) = #{q} AND <include refid="videoIdNotNone"/>
			 ORDER BY m.id LIMIT #{cap})
			UNION ALL
			(SELECT m.id, 1 AS tier FROM music m
			 WHERE <include refid="artistLower"/> = #{q} AND lower(m.title) &lt;&gt; #{q}
			   AND <include refid="videoIdNotNone"/>
			 ORDER BY m.id LIMIT #{cap})
			UNION ALL
			(SELECT m.id, 2 AS tier FROM music m
			 WHERE <include refid="titlePrefixed"/> AND lower(m.title) &lt;&gt; #{q}
			   AND <include refid="artistLower"/> &lt;&gt; #{q}
			   AND <include refid="videoIdNotNone"/>
			 ORDER BY m.id LIMIT #{cap})
			UNION ALL
			(SELECT m.id, 3 AS tier FROM music m
			 WHERE <include refid="artistPrefixed"/> AND <include refid="artistLower"/> &lt;&gt; #{q}
			   AND NOT (<include refid="titlePrefixed"/>)
			   AND <include refid="videoIdNotNone"/>
			 ORDER BY m.id LIMIT #{cap})
		) t
		JOIN music m ON m.id = t.id
		ORDER BY t.tier ASC, t.id ASC
		LIMIT #{size} OFFSET #{offset}
	</select>

	<!--
		아티스트 필터 검색. music 이 없으면 아티스트 완전/앞일치 2단계,
		있으면 음악·아티스트 완전일치 조합 4단계다. 단계는 상호 배타적이라
		UNION ALL 결과와 페이지 사이에 같은 곡이 중복되지 않는다.

		기존 lower(title), coalesce(lower(artist), '') 함수 인덱스 표현식을 그대로 쓴다.
		전체 통합 검색 findPage 는 실행계획 회귀를 피하려고 변경하지 않는다.
	-->
	<select id="findFilteredPage" timeout="2" resultType="com.ssafy.backend.music.dto.MusicSearchRow">
		SELECT m.id, m.title, m.artist, m.album, m.video_id,
		<include refid="locationColumns"/>
		FROM (
			<choose>
				<when test="music != null">
					(SELECT m.id, 0 AS tier FROM music m
					 WHERE lower(m.title) = #{music} AND <include refid="artistLower"/> = #{artist}
					   AND <include refid="videoIdNotNone"/>
					 ORDER BY m.id LIMIT #{cap})
					UNION ALL
					(SELECT m.id, 1 AS tier FROM music m
					 WHERE lower(m.title) LIKE #{musicPrefix} ESCAPE '\' AND lower(m.title) &lt;&gt; #{music}
					   AND <include refid="artistLower"/> = #{artist}
					   AND <include refid="videoIdNotNone"/>
					 ORDER BY m.id LIMIT #{cap})
					UNION ALL
					(SELECT m.id, 2 AS tier FROM music m
					 WHERE lower(m.title) = #{music}
					   AND <include refid="artistLower"/> LIKE #{artistPrefix} ESCAPE '\'
					   AND <include refid="artistLower"/> &lt;&gt; #{artist}
					   AND <include refid="videoIdNotNone"/>
					 ORDER BY m.id LIMIT #{cap})
					UNION ALL
					(SELECT m.id, 3 AS tier FROM music m
					 WHERE lower(m.title) LIKE #{musicPrefix} ESCAPE '\' AND lower(m.title) &lt;&gt; #{music}
					   AND <include refid="artistLower"/> LIKE #{artistPrefix} ESCAPE '\'
					   AND <include refid="artistLower"/> &lt;&gt; #{artist}
					   AND <include refid="videoIdNotNone"/>
					 ORDER BY m.id LIMIT #{cap})
				</when>
				<otherwise>
					(SELECT m.id, 0 AS tier FROM music m
					 WHERE <include refid="artistLower"/> = #{artist}
					   AND <include refid="videoIdNotNone"/>
					 ORDER BY m.id LIMIT #{cap})
					UNION ALL
					(SELECT m.id, 1 AS tier FROM music m
					 WHERE <include refid="artistLower"/> LIKE #{artistPrefix} ESCAPE '\'
					   AND <include refid="artistLower"/> &lt;&gt; #{artist}
					   AND <include refid="videoIdNotNone"/>
					 ORDER BY m.id LIMIT #{cap})
				</otherwise>
			</choose>
		) t
		JOIN music m ON m.id = t.id
		ORDER BY t.tier ASC, t.id ASC
		LIMIT #{size} OFFSET #{offset}
	</select>

	<select id="findGenresByMusicIds" resultType="com.ssafy.backend.music.dto.MusicGenreRow">
		SELECT mg.music_id, g.name
		FROM music_genre mg
		JOIN genre g ON g.id = mg.genre_id
		WHERE mg.music_id IN
		<foreach item="musicId" collection="musicIdList" open="(" separator="," close=")">
			#{musicId}
		</foreach>
		ORDER BY mg.music_id, g.name
	</select>
</mapper>
