<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.backend.report.mapper.MusicReportMapper">

    <!-- 테이블: music_report (report_id, music_id, user_email, reason, detail_reason, created_at). -->
    <select id="insert" resultType="long">
        INSERT INTO music_report (music_id, user_email, reason, detail_reason)
        VALUES (#{musicId}, #{userEmail}, #{reason}, #{detailReason})
            RETURNING report_id
    </select>

</mapper>