<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.backend.user.mapper.UserMapper">

	<!-- "user"는 Postgres 예약어라 반드시 큰따옴표로 감싼다 -->

	<resultMap id="userProfileRowMap" type="com.ssafy.backend.user.dto.UserProfileRow">
		<result property="email" column="email"/>
		<result property="name" column="name"/>
		<result property="nickname" column="nickname"/>
		<result property="imageUrl" column="image_url"/>
		<result property="isPublic" column="is_public"/>
		<result property="tutorialCompleted" column="tutorial_completed"/>
		<result property="lastActiveAt" column="last_active_at"/>
		<result property="createdAt" column="created_at"/>
	</resultMap>

	<select id="findProfileByEmail" resultMap="userProfileRowMap">
		SELECT email, name, nickname, image_url, is_public, tutorial_completed, last_active_at, created_at
		FROM "user"
		WHERE email = #{email}
	</select>

	<update id="updateTutorialCompleted">
		UPDATE "user"
		SET tutorial_completed = true,
		    updated_at = now()
		WHERE email = #{email}
	</update>

	<update id="updateNickname">
		UPDATE "user"
		SET nickname = #{nickname},
		    updated_at = now()
		WHERE email = #{email}
	</update>

	<update id="updateImageUrl">
		UPDATE "user"
		SET image_url = #{imageUrl},
		    updated_at = now()
		WHERE email = #{email}
	</update>

	<update id="updateIsPublic">
		UPDATE "user"
		SET is_public = #{isPublic},
		    updated_at = now()
		WHERE email = #{email}
	</update>

	<!--
		사용자가 재생한 곡 수 (중복 제외, S15P21A405-430). play_history 는 재생할 때마다 한 줄씩 쌓이므로
		같은 곡을 여러 번 들으면 여러 줄이 된다 — 곡 수는 music_id 의 distinct 개수다.
		(email, music_id) 인덱스가 있어야 전체 테이블이 아니라 그 사용자 기록만 읽는다
		(db/play_history_001_email_music_index.sql). 인덱스가 없으면 로그가 쌓일수록 느려진다.
	-->
	<select id="countDistinctPlayedMusic" resultType="int">
		SELECT COUNT(DISTINCT music_id)
		FROM play_history
		WHERE email = #{email}
	</select>

	<!--
		사용자가 발견한 곡 수 (S15P21A405-597). music_discovery 는 곡당 한 줄(music_id PK)이고
		그 줄의 email 이 최초 청취자라, 그 사람의 줄 수가 곧 발견한 곡 수다 — DISTINCT 가 필요 없다.
		PK 와 (discovered_at, email) 인덱스로는 email 만으로 찾지 못한다.
		(email, discovered_at) 인덱스가 있어야 그 사용자 구간만 읽는다
		(db/music_discovery_002_email_index.sql).
	-->
	<select id="countDiscoveredMusic" resultType="int">
		SELECT COUNT(*)
		FROM music_discovery
		WHERE email = #{email}
	</select>

	<!--
		마지막으로 재생한 곡 (S15P21A405-713). played_at 이 같은 행(따라가기로 한꺼번에 들어간 줄)은
		id 로 순서를 굳힌다 — 실시간 입장 위치(PlayHistoryMapper.findLatestMusicId)와 같은 규칙이라
		프로필의 마지막 곡과 지도에 선 자리가 어긋나지 않는다. 기록이 없으면 결과 없음 → null.
		(email, played_at, id) 인덱스가 있어야 그 사용자의 최신 한 줄만 읽는다
		(db/play_history_003_email_played_at_index.sql). 없으면 그 사용자 기록 전체를 정렬한다.
	-->
	<select id="findLastPlayedMusicId" resultType="long">
		SELECT music_id
		FROM play_history
		WHERE email = #{email}
		ORDER BY played_at DESC, id DESC
		LIMIT 1
	</select>

</mapper>
