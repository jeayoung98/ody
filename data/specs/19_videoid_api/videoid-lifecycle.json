  "cards": [
    {
      "dot": "emerald",
      "title": "임베드 확인은 양쪽 경로에 다 걸린다",
      "items": [
        "확정·추측 둘 다 임베드 가능·public·비라이브·age_limit 0 을 요구한다",
        "추측 후보도 영상을 열어 같은 조건을 확인한 뒤 채택한다",
        "verified 는 길이 ±2초 대조가 필요해 duration 없이는 안 나온다"
      ]
    },
    {
      "dot": "rose",
      "title": "retry_pending 과 unplayable 은 다른 종착점",
      "items": [
        "retry_pending 은 검색이 실패한 상태이고 10분 뒤 재조회한다",
        "unplayable 은 후보를 다 보고 내린 판정이며 best 가 null 이다",
        "임베드 예산 3건을 다 쓰면 채택이 아니라 거절로 끝난다"
      ]
    }
