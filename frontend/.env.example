# 이 파일은 예시다. 주석을 풀지 않는다 — 실제 값은 각자 .env.local (gitignore 됨) 에 둔다.

# 브라우저는 백엔드를 직접 부르지 않는다. next.config.ts 의 rewrite 가 Next 서버를 통해
# 아래 주소로 프록시한다 — 배포 백엔드가 Origin 이 붙은 요청을 전부 403 으로 막고 있고,
# refresh 쿠키도 Secure; SameSite=Lax 라 크로스 사이트 요청에는 실리지 않기 때문이다.
#
# 기본값이 이미 배포 주소(https://j15a405.p.ssafy.io)라 보통은 설정하지 않아도 된다.
# 로컬 백엔드를 보고 싶을 때만 .env.local 에 넣는다.
# 주의: j15a405a (a 붙음) 는 Jenkins·Grafana 가 있는 master-node 라 API 가 없다.
# BACKEND_ORIGIN=https://j15a405.p.ssafy.io

# 서버 전용 백엔드 액세스 토큰 (Bearer). **브라우저에 노출되지 않는다.**
#
# **지금은 없어도 된다.** 유저 테스트 동안 백엔드가 인증을 한시 해제해 둬서
# (docs/rules/BACKEND-NOTES.md A-17) 토큰 없이도 조회 API 가 응답한다.
# 값이 있으면 라우트 핸들러가 Bearer 로 붙여 보내고, 없으면 안 붙이고 보낸다.
#
# A-17 이 원복되면 조회가 401 이 된다. 그때 이 값을 넣으면 예전처럼 동작한다 —
# 로그인이 목이라 브라우저에는 백엔드가 인정하는 토큰이 없어서, Next 서버가
# 이 토큰으로 대신 호출하는 구조다.
# BACKEND_ACCESS_TOKEN=

# 목 데이터를 강제로 쓴다. 배포 백엔드가 내려갔거나, 목 화면을 일부러 볼 때만 켠다.
# 켜지 않으면 지도·검색·곡 상세·주변 탐색이 전부 **배포 백엔드의 실제 곡**으로 돈다.
# 실패해도 조용히 목으로 떨어지지 않는다 — 실데이터인 줄 알고 목을 보는 일이 없어야 한다.
# USE_MOCK_API=1

# 브라우저가 백엔드를 직접 호출하게 만드는 값. 지금은 비워둔다 —
# 배포 백엔드가 Origin 붙은 요청을 전부 403 Invalid CORS request 로 막는다 (B-17).
# NEXT_PUBLIC_API_URL=

# 구글 로그인(AUTH-01/02)용 OAuth 클라이언트 ID. 비밀값이 아니다 — 브라우저에 그대로 노출된다.
# 구글 로그인에는 목이 없다. 브라우저가 구글에서 idToken 을 받아
# POST /api/auth/login/google 로 보내므로(위 rewrite 프록시를 탄다) 이 값이 필요하다.
#
# 전제 두 가지:
#  - 백엔드가 idToken audience 검증에 쓰는 것과 **같은 클라이언트 ID** 여야 한다
#  - Google Cloud Console 의 그 클라이언트에 쓰려는 오리진(예: http://localhost:3000)이
#    '승인된 JavaScript 원본' 으로 등록돼 있어야 한다
#
# 값이 없으면 로그인 화면에 구글 버튼 대신 미설정 안내가 뜬다.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=602769818964-nt9s5tgu7u89cdvq7t0couihdf6floab.apps.googleusercontent.com

# 로그인 게이트를 다시 켠다. 지금은 유저 테스트 때문에 꺼져 있다 —
# 로그인을 태우지 않기로 했고(docs/rules/BACKEND-NOTES.md A-17) 로그인은 아직 목이라
# 테스터가 계정을 만들 수도 없다. 로그인·가입 화면을 손볼 때만 켠다.
# 되돌리는 시점은 A-17 과 같다: 유저 테스트 종료 또는 로그인 실연동 중 먼저 오는 쪽.
# NEXT_PUBLIC_REQUIRE_LOGIN=1

# 유저 테스트 동안 감춰 둔 기능을 하나씩 다시 켠다 (S15P21A405-333).
# 위 로그인 게이트와 **세트**다 — 되돌리는 시점도 같다 (유저 테스트 종료).
#
# 이번 테스트에서 볼 것은 탐색·주변 탐색·검색·여정 네 가지다. 나머지는 아직 목이거나
# 실연동이 덜 끝나서, 열려 있으면 피드백이 그쪽으로 쏠린다.
# 기능을 지운 게 아니라 입구만 닫았다. 값을 1 로 두고 다시 빌드하면 그대로 돌아온다.
# (NEXT_PUBLIC_* 은 빌드 시각에 박히므로 런타임 토글이 아니다.)
#
# NEXT_PUBLIC_FEATURE_PROFILE=1    # 마이페이지(내 프로필 패널)
# NEXT_PUBLIC_FEATURE_PLAYLIST=1   # 플레이리스트 전체 (패널·플리에 추가·관련 플리)
# NEXT_PUBLIC_FEATURE_SOCIAL=1     # 주변 사람 탭·지도 위 사람 표식·따라가기·반응
# NEXT_PUBLIC_FEATURE_CHART=1      # 차트(인기 플리·유저 랭킹)

# 테스트 안내 화면을 끈다 (S15P21A405-343). 기본은 켜져 있다 — 지금이 유저 테스트 기간이다.
# 켜져 있으면 튜토리얼 앞에 "무엇을 보려는 테스트인지 · 필수 설문 2개" 안내가 한 장 뜬다.
# 되돌리는 시점은 위 로그인 게이트와 같다: 유저 테스트 종료.
# NEXT_PUBLIC_TEST_MODE=0

# 사용자 설문 (S15P21A405-294). "true" 일 때만 설문이 뜬다.                   # REMOVE-WITH-SURVEY
# 최종 배포 때는 이 값을 빼거나 false 로 둔다 — 없으면 설문이 렌더되지 않는다.  # REMOVE-WITH-SURVEY
# NEXT_PUBLIC_SURVEY_ENABLED=true                                             # REMOVE-WITH-SURVEY
